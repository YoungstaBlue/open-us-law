<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" status="repealed" style="-uslm-lc:I80" id="idb92f906c-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s1727"><ns0:num value="1727">[§ 1727.</ns0:num><ns0:heading> Repealed. <ns0:ref href="/us/pl/90/384/s1/a">Pub. L. 90–384, § 1(a)</ns0:ref>, <ns0:date date="1968-07-05">July 5, 1968</ns0:date>, <ns0:ref href="/us/stat/82/292">82 Stat. 292</ns0:ref>]</ns0:heading><ns0:notes type="uscNote" id="idb92f906d-47c4-11f1-9a61-b1559996dfe8">
<ns0:note topic="removalDescription" id="idb92f906e-47c4-11f1-9a61-b1559996dfe8">
<ns0:p style="-uslm-lc:I21" class="indent0">Section, <ns0:ref href="/us/act/1948-06-25/ch645">act June 25, 1948, ch. 645</ns0:ref>, <ns0:ref href="/us/stat/62/785">62 Stat. 785</ns0:ref>, provided for a fine of not more than $50 for postage accounting violations.</ns0:p>
</ns0:note>
<ns0:note style="-uslm-lc:I74" role="crossHeading" topic="statutoryNotes" id="idb92f906f-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered"><ns0:b>Statutory Notes and Related Subsidiaries</ns0:b></ns0:heading></ns0:note>
<ns0:note style="-uslm-lc:I74" topic="savings" id="idb92f9070-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered smallCaps">Savings Provision</ns0:heading><ns0:p><ns0:ref href="/us/pl/90/384/s2">Pub. L. 90–384, § 2</ns0:ref>, <ns0:date date="1968-07-05">July 5, 1968</ns0:date>, <ns0:ref href="/us/stat/82/292">82 Stat. 292</ns0:ref>, provided that: <ns0:quotedContent origin="/us/pl/90/384/s2">“Nothing in this Act [repealing this section] shall be construed to affect in any way any prosecution for any offense occurring prior to the date of enactment of such Act [<ns0:date date="1968-07-05">July 5, 1968</ns0:date>].”</ns0:quotedContent>
</ns0:p>
</ns0:note>
