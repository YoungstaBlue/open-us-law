<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="idb9320140-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s1793"><ns0:num value="1793">§ 1793.</ns0:num><ns0:heading> Trespass on Bureau of Prisons reservations and land</ns0:heading><ns0:content>
<ns0:p style="-uslm-lc:I11" class="indent0">Whoever, without lawful authority or permission, goes upon a reservation, land, or a facility of the Bureau of Prisons shall be fined under this title or imprisoned not more than six months, or both.</ns0:p>
</ns0:content><ns0:sourceCredit id="idb9320141-47c4-11f1-9a61-b1559996dfe8">(Added <ns0:ref href="/us/pl/99/646/s64/a">Pub. L. 99–646, § 64(a)</ns0:ref>, <ns0:date date="1986-11-10">Nov. 10, 1986</ns0:date>, <ns0:ref href="/us/stat/100/3614">100 Stat. 3614</ns0:ref>; amended <ns0:ref href="/us/pl/103/322/tXXXIII/s330016/1/G">Pub. L. 103–322, title XXXIII, § 330016(1)(G)</ns0:ref>, <ns0:date date="1994-09-13">Sept. 13, 1994</ns0:date>, <ns0:ref href="/us/stat/108/2147">108 Stat. 2147</ns0:ref>.)</ns0:sourceCredit>
<ns0:notes type="uscNote" id="idb9320142-47c4-11f1-9a61-b1559996dfe8">
<ns0:note style="-uslm-lc:I74" role="crossHeading" topic="editorialNotes" id="idb9320143-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered"><ns0:b>Editorial Notes</ns0:b></ns0:heading></ns0:note>
<ns0:note style="-uslm-lc:I74" topic="amendments" id="idb9320144-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered smallCaps">Amendments</ns0:heading><ns0:p style="-uslm-lc:I21" class="indent0">1994—<ns0:ref href="/us/pl/103/322">Pub. L. 103–322</ns0:ref> substituted “fined under this title” for “fined not more than $500”.</ns0:p>
</ns0:note>
