<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="idb8a2e081-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s18"><ns0:num value="18">§ 18.</ns0:num><ns0:heading> Organization defined</ns0:heading><ns0:content>
<ns0:p style="-uslm-lc:I11" class="indent0">As used in this title, the term “organization” means a person other than an individual.</ns0:p>
</ns0:content><ns0:sourceCredit id="idb8a2e082-47c4-11f1-9a61-b1559996dfe8">(Added <ns0:ref href="/us/pl/99/646/s38/a">Pub. L. 99–646, § 38(a)</ns0:ref>, <ns0:date date="1986-11-10">Nov. 10, 1986</ns0:date>, <ns0:ref href="/us/stat/100/3599">100 Stat. 3599</ns0:ref>; amended <ns0:ref href="/us/pl/100/185/s4/c">Pub. L. 100–185, § 4(c)</ns0:ref>, <ns0:date date="1987-12-11">Dec. 11, 1987</ns0:date>, <ns0:ref href="/us/stat/101/1279">101 Stat. 1279</ns0:ref>; <ns0:ref href="/us/pl/100/690/tVII/s7012">Pub. L. 100–690, title VII, § 7012</ns0:ref>, <ns0:date date="1988-11-18">Nov. 18, 1988</ns0:date>, <ns0:ref href="/us/stat/102/4395">102 Stat. 4395</ns0:ref>.)</ns0:sourceCredit>
