<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="idb8c1da0d-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s229D"><ns0:num value="229D">§ 229D.</ns0:num><ns0:heading> Injunctions</ns0:heading>
<ns0:chapeau style="-uslm-lc:I11" class="indent0">The United States may obtain in a civil action an injunction against—</ns0:chapeau><ns0:paragraph style="-uslm-lc:I12" class="indent1" id="idb8c1da0e-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s229D/1"><ns0:num value="1">(1)</ns0:num><ns0:content> the conduct prohibited under section 229 or 229C of this title; or</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="idb8c1da0f-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s229D/2"><ns0:num value="2">(2)</ns0:num><ns0:content> the preparation or solicitation to engage in conduct prohibited under section 229 or 229D <ns0:ref class="footnoteRef" idref="fn002030">1</ns0:ref><ns0:note type="footnote" id="fn002030"><ns0:num>1</ns0:num> So in original.</ns0:note> of this title.</ns0:content>
</ns0:paragraph>
