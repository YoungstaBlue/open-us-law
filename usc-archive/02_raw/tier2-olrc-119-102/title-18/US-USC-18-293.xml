<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" status="repealed" style="-uslm-lc:I80" id="idb8c69561-47c4-11f1-9a61-b1559996dfe8" identifier="/us/usc/t18/s293"><ns0:num value="293">[§ 293.</ns0:num><ns0:heading> Repealed. <ns0:ref href="/us/pl/101/123/s3/a">Pub. L. 101–123, § 3(a)</ns0:ref>, <ns0:date date="1989-10-23">Oct. 23, 1989</ns0:date>, <ns0:ref href="/us/stat/103/760">103 Stat. 760</ns0:ref>]</ns0:heading><ns0:notes type="uscNote" id="idb8c69562-47c4-11f1-9a61-b1559996dfe8">
<ns0:note topic="removalDescription" id="idb8c69563-47c4-11f1-9a61-b1559996dfe8">
<ns0:p style="-uslm-lc:I21" class="indent0">Section, added <ns0:ref href="/us/pl/100/700/s3/a">Pub. L. 100–700, § 3(a)</ns0:ref>, <ns0:date date="1988-11-19">Nov. 19, 1988</ns0:date>, <ns0:ref href="/us/stat/102/4632">102 Stat. 4632</ns0:ref>, related to limitation on Government contract costs.</ns0:p>
</ns0:note>
<ns0:note style="-uslm-lc:I74" role="crossHeading" topic="statutoryNotes" id="idb8c69564-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered"><ns0:b>Statutory Notes and Related Subsidiaries</ns0:b></ns0:heading></ns0:note>
<ns0:note style="-uslm-lc:I74" topic="effectiveDate" id="idb8c69565-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered smallCaps">Effective Date of Repeal</ns0:heading><ns0:p><ns0:ref href="/us/pl/101/123/s3/b">Pub. L. 101–123, § 3(b)</ns0:ref>, <ns0:date date="1989-10-23">Oct. 23, 1989</ns0:date>, <ns0:ref href="/us/stat/103/760">103 Stat. 760</ns0:ref>, provided that: <ns0:quotedContent origin="/us/pl/101/123/s3/b">“The repeal made by this section [repealing this section and provisions formerly set out as a note below] shall be deemed to be effective on the date of enactment of <ns0:ref href="/us/pl/100/700">Public Law 100–700</ns0:ref> [<ns0:date date="1988-11-19">Nov. 19, 1988</ns0:date>].”</ns0:quotedContent>
</ns0:p>
</ns0:note>
<ns0:note style="-uslm-lc:I74" topic="effectiveDate" id="idb8c69566-47c4-11f1-9a61-b1559996dfe8"><ns0:heading class="centered smallCaps">Effective Date</ns0:heading><ns0:p style="-uslm-lc:I21" class="indent0"><ns0:ref href="/us/pl/100/700/s3/c">Pub. L. 100–700, § 3(c)</ns0:ref>, <ns0:date date="1988-11-19">Nov. 19, 1988</ns0:date>, <ns0:ref href="/us/stat/102/4633">102 Stat. 4633</ns0:ref>, which provided that this section was to apply to contracts entered into after <ns0:date date="1988-11-19">Nov. 19, 1988</ns0:date>, was repealed by <ns0:ref href="/us/pl/101/123/s3/a">Pub. L. 101–123, § 3(a)</ns0:ref>, <ns0:date date="1989-10-23">Oct. 23, 1989</ns0:date>, <ns0:ref href="/us/stat/103/760">103 Stat. 760</ns0:ref>.</ns0:p>
</ns0:note>
</ns0:notes>
</ns0:section>
