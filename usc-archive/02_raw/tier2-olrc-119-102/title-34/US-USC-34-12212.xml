<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id4cfdb52b-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12212"><ns0:num value="12212">§ 12212.</ns0:num><ns0:heading> Prohibition</ns0:heading><ns0:content>
<ns0:p style="-uslm-lc:I11" class="indent0">None of the funds authorized under this part shall be used to finance the construction of housing.</ns0:p>
</ns0:content><ns0:sourceCredit id="id4cfdb52c-5dcd-11f1-b11b-9e551e93f87d">(<ns0:ref href="/us/pl/103/322/tIII/s31133">Pub. L. 103–322, title III, § 31133</ns0:ref>, <ns0:date date="1994-09-13">Sept. 13, 1994</ns0:date>, <ns0:ref href="/us/stat/108/1888">108 Stat. 1888</ns0:ref>.)</ns0:sourceCredit>
<ns0:notes type="uscNote" id="id4cfdb52d-5dcd-11f1-b11b-9e551e93f87d">
<ns0:note style="-uslm-lc:I74" role="crossHeading" topic="editorialNotes" id="id4cfdb52e-5dcd-11f1-b11b-9e551e93f87d"><ns0:heading class="centered"><ns0:b>Editorial Notes</ns0:b></ns0:heading></ns0:note>
<ns0:note style="-uslm-lc:I76" topic="codification" id="id4cfdb52f-5dcd-11f1-b11b-9e551e93f87d"><ns0:heading class="centered smallCaps">Codification</ns0:heading>
<ns0:p style="-uslm-lc:I21" class="indent0">Section was formerly classified to <ns0:ref href="/us/usc/t42/s13853">section 13853 of Title 42</ns0:ref>, The Public Health and Welfare, prior to editorial reclassification and renumbering as this section.</ns0:p>
</ns0:note>
