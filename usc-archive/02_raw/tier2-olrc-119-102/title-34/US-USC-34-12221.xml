<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id4cfdb531-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12221"><ns0:num value="12221">§ 12221.</ns0:num><ns0:heading> Grant authorization</ns0:heading><ns0:subsection style="-uslm-lc:I19" class="indent2 firstIndent-2" id="id4cfdb532-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12221/a"><ns0:num value="a" class="bold">(a)</ns0:num><ns0:heading class="bold"> In general</ns0:heading><ns0:content><ns0:p style="-uslm-lc:I11" class="indent0">The Attorney General may make grants to State, Indian tribal, or local prosecutors for the purpose of supporting the creation or expansion of community-based justice programs.</ns0:p>
</ns0:content>
</ns0:subsection>
<ns0:subsection style="-uslm-lc:I19" class="indent2 firstIndent-2" id="id4cfdb533-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12221/b"><ns0:num value="b" class="bold">(b)</ns0:num><ns0:heading class="bold"> Consultation</ns0:heading><ns0:content><ns0:p style="-uslm-lc:I11" class="indent0">The Attorney General may consult with the Ounce of Prevention Council in making grants under subsection (a).</ns0:p>
</ns0:content>
</ns0:subsection>
<ns0:sourceCredit id="id4cfdb534-5dcd-11f1-b11b-9e551e93f87d">(<ns0:ref href="/us/pl/103/322/tIII/s31701">Pub. L. 103–322, title III, § 31701</ns0:ref>, <ns0:date date="1994-09-13">Sept. 13, 1994</ns0:date>, <ns0:ref href="/us/stat/108/1890">108 Stat. 1890</ns0:ref>.)</ns0:sourceCredit>
<ns0:notes type="uscNote" id="id4cfdb535-5dcd-11f1-b11b-9e551e93f87d">
<ns0:note style="-uslm-lc:I74" role="crossHeading" topic="editorialNotes" id="id4cfdb536-5dcd-11f1-b11b-9e551e93f87d"><ns0:heading class="centered"><ns0:b>Editorial Notes</ns0:b></ns0:heading></ns0:note>
<ns0:note style="-uslm-lc:I76" topic="codification" id="id4cfdb537-5dcd-11f1-b11b-9e551e93f87d"><ns0:heading class="centered smallCaps">Codification</ns0:heading>
<ns0:p style="-uslm-lc:I21" class="indent0">Section was formerly classified to <ns0:ref href="/us/usc/t42/s13861">section 13861 of Title 42</ns0:ref>, The Public Health and Welfare, prior to editorial reclassification and renumbering as this section.</ns0:p>
</ns0:note>
</ns0:notes>
</ns0:section>
