<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id4d075294-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443"><ns0:num value="12443">§ 12443.</ns0:num><ns0:heading> Eligible entities</ns0:heading>
<ns0:chapeau style="-uslm-lc:I11" class="indent0">Entities eligible for grants under this part include—</ns0:chapeau><ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d075295-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/1"><ns0:num value="1">(1)</ns0:num><ns0:content> jurisdictions or agencies within jurisdictions having authority or responsibility for developing or maintaining public databases, registries or victim notification systems;</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d075296-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/2"><ns0:num value="2">(2)</ns0:num><ns0:content> nonprofit nongovernmental victim advocacy organizations having expertise regarding confidentiality, privacy, and information technology and how these issues are likely to impact the safety of victims;</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d075297-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/3"><ns0:num value="3">(3)</ns0:num><ns0:content> States or State agencies;</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d075298-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/4"><ns0:num value="4">(4)</ns0:num><ns0:content> local governments or agencies;</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d075299-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/5"><ns0:num value="5">(5)</ns0:num><ns0:content> Indian tribal governments or tribal organizations;</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d07529a-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/6"><ns0:num value="6">(6)</ns0:num><ns0:content> territorial governments, agencies, or organizations; or</ns0:content>
</ns0:paragraph>
<ns0:paragraph style="-uslm-lc:I12" class="indent1" id="id4d07529b-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12443/7"><ns0:num value="7">(7)</ns0:num><ns0:content> nonprofit nongovernmental victim advocacy organizations, including statewide domestic violence and sexual assault coalitions.</ns0:content>
</ns0:paragraph>
<ns0:sourceCredit id="id4d07529c-5dcd-11f1-b11b-9e551e93f87d">(<ns0:ref href="/us/pl/103/322/tIV/s41103">Pub. L. 103–322, title IV, § 41103</ns0:ref>, as added <ns0:ref href="/us/pl/109/162/tI/s107">Pub. L. 109–162, title I, § 107</ns0:ref>, <ns0:date date="2006-01-05">Jan. 5, 2006</ns0:date>, <ns0:ref href="/us/stat/119/2983">119 Stat. 2983</ns0:ref>.)</ns0:sourceCredit>
