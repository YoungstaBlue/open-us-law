<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id4d15a9d5-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12574"><ns0:num value="12574">§ 12574.</ns0:num><ns0:heading> Scholarships</ns0:heading><ns0:subsection style="-uslm-lc:I19" class="indent2 firstIndent-2" id="id4d15a9d6-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12574/a"><ns0:num value="a" class="bold">(a)</ns0:num><ns0:heading class="bold"> Period of award</ns0:heading><ns0:content><ns0:p style="-uslm-lc:I11" class="indent0">Scholarships awarded under this part shall be for a period of 1 academic year.</ns0:p>
</ns0:content>
</ns0:subsection>
<ns0:subsection style="-uslm-lc:I19" class="indent2 firstIndent-2" id="id4d15a9d7-5dcd-11f1-b11b-9e551e93f87d" identifier="/us/usc/t34/s12574/b"><ns0:num value="b" class="bold">(b)</ns0:num><ns0:heading class="bold"> Use of scholarships</ns0:heading><ns0:content><ns0:p style="-uslm-lc:I11" class="indent0">Each individual awarded a scholarship under this part may use the scholarship for educational expenses at an institution of higher education.</ns0:p>
</ns0:content>
</ns0:subsection>
<ns0:sourceCredit id="id4d15a9d8-5dcd-11f1-b11b-9e551e93f87d">(<ns0:ref href="/us/pl/103/322/tXX/s200205">Pub. L. 103–322, title XX, § 200205</ns0:ref>, <ns0:date date="1994-09-13">Sept. 13, 1994</ns0:date>, <ns0:ref href="/us/stat/108/2059">108 Stat. 2059</ns0:ref>.)</ns0:sourceCredit>
