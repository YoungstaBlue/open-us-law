<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id99103556-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s2000b–3"><ns0:num value="2000b–3">§ 2000b–3.</ns0:num><ns0:heading> “Complaint” defined</ns0:heading><ns0:content>
<ns0:p style="-uslm-lc:I11" class="indent0">A complaint as used in this subchapter is a writing or document within the meaning of section 1001, title 18.</ns0:p>
</ns0:content><ns0:sourceCredit id="id99103557-86b3-11f1-9949-c831ab2bbedc">(<ns0:ref href="/us/pl/88/352/tIII/s304">Pub. L. 88–352, title III, § 304</ns0:ref>, <ns0:date date="1964-07-02">July 2, 1964</ns0:date>, <ns0:ref href="/us/stat/78/246">78 Stat. 246</ns0:ref>.)</ns0:sourceCredit>
</ns0:section>
