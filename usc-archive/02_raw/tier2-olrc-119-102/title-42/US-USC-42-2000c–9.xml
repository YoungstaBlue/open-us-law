<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id9910358e-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s2000c–9"><ns0:num value="2000c–9">§ 2000c–9.</ns0:num><ns0:heading> Classification and assignment</ns0:heading><ns0:content>
<ns0:p style="-uslm-lc:I11" class="indent0">Nothing in this subchapter shall prohibit classification and assignment for reasons other than race, color, religion, sex or national origin.</ns0:p>
</ns0:content><ns0:sourceCredit id="id9910358f-86b3-11f1-9949-c831ab2bbedc">(<ns0:ref href="/us/pl/88/352/tIV/s410">Pub. L. 88–352, title IV, § 410</ns0:ref>, <ns0:date date="1964-07-02">July 2, 1964</ns0:date>, <ns0:ref href="/us/stat/78/249">78 Stat. 249</ns0:ref>; <ns0:ref href="/us/pl/92/318/tIX/s906/a">Pub. L. 92–318, title IX, § 906(a)</ns0:ref>, <ns0:date date="1972-06-23">June 23, 1972</ns0:date>, <ns0:ref href="/us/stat/86/375">86 Stat. 375</ns0:ref>.)</ns0:sourceCredit>
<ns0:notes type="uscNote" id="id99103590-86b3-11f1-9949-c831ab2bbedc">
