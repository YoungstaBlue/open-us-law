<ns0:section xmlns:ns0="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id991c1be1-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s2000e–11"><ns0:num value="2000e–11">§ 2000e–11.</ns0:num><ns0:heading> Veterans’ special rights or preference</ns0:heading><ns0:content>
<ns0:p style="-uslm-lc:I11" class="indent0">Nothing contained in this subchapter shall be construed to repeal or modify any Federal, State, territorial, or local law creating special rights or preference for veterans.</ns0:p>
</ns0:content><ns0:sourceCredit id="id991c1be2-86b3-11f1-9949-c831ab2bbedc">(<ns0:ref href="/us/pl/88/352/tVII/s712">Pub. L. 88–352, title VII, § 712</ns0:ref>, <ns0:date date="1964-07-02">July 2, 1964</ns0:date>, <ns0:ref href="/us/stat/78/265">78 Stat. 265</ns0:ref>.)</ns0:sourceCredit>
</ns0:section>
